# Paperu — pnpm configuration
# Conservative, deterministic installs for a commercial product.

# Use a shared content-addressable store to save disk and bandwidth.
store-dir=${HOME}/.local/share/pnpm/store

# Hoisting is restricted to keep dependency graphs honest.
hoist-pattern[]=*eslint*
hoist-pattern[]=*typescript*

# Never auto-approve peer-deps mismatches silently.
strict-peer-dependencies=true

# Lockfile is required and committed for reproducible installs.
frozen-lockfile-in-ci=true

# Package imports should be explicit; no magic hoisting into globals.
shamefully-hoist=false

# Tauri native deps must be resolved correctly.
node-linker=isolated
