{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperu",
  "version": "0.1.0",
  "identifier": "app.paperu.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Paperu",
        "label": "main",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:",
      "devCsp": null,
      "freezePrototype": false,
      "dangerousDisableAssetCspModification": false
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "\u00a9 2026 Paperu. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Local-first file workspace",
    "longDescription": "Paperu is a Windows-first, local-first file workspace. Privacy-preserving document and file utilities that run on your computer.",
    "publisher": "Paperu",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "name": "PDF",
        "ext": [
          "pdf"
        ],
        "description": "PDF document",
        "role": "Viewer"
      },
      {
        "name": "Image",
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "bmp",
          "gif"
        ],
        "description": "Image file",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {}
}
